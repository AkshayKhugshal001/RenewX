# Copy this file to .env and fill in the values. Never commit .env.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Same values as frontend/.env (used only to verify the user's login token)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Where the React app runs (comma-separated if more than one)
FRONTEND_ORIGINS=http://localhost:5173

# AI assistant (optional). Free key: Google AI Studio → Get API key. Never commit the real key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# Alternative: LLM_PROVIDER=groq, GROQ_API_KEY=..., GROQ_MODEL=<a current Groq chat model>

# Scheduled daily refresh: long random text, same value as the GitHub secret RENEWX_CRON_SECRET
CRON_SECRET=generate-a-long-random-secret
